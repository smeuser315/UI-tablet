<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoanDashboard">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/LoanDashboardAppBar"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/LoanDashboardImageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/ic_arrow_back_black"
                    android:onClick="backPress"
                    app:layout_constraintBottom_toBottomOf="@+id/LoanDashboardTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/LoanDashboardTitle"
                     />

                <TextView
                    android:id="@+id/LoanDashboardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:fontFamily="@font/open_sans_bold"
                    android:padding="2dp"
                    android:text="Loan Dashboard"
                    android:textColor="#494949"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="20dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline19"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="20dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline19"
                app:layout_constraintStart_toStartOf="@+id/guideline20"
                app:layout_constraintTop_toBottomOf="@+id/LoanDashboardAppBar">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_bg">



                    <TextView
                        android:id="@+id/textView18"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:clickable="false"
                        android:fontFamily="@font/opensans_semibold"
                        android:text="Loan Amount"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="₦ 100,000.00"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="@+id/textView18"
                        app:layout_constraintTop_toBottomOf="@+id/textView18"
                        app:layout_constraintBottom_toTopOf="@id/textView180"/>

                    <TextView
                        android:id="@+id/textView180"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clickable="false"
                        android:fontFamily="@font/opensans_semibold"
                        android:text="Loan Limit: ₦150,000.00"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/textView19"
                        app:layout_constraintTop_toBottomOf="@+id/textView19" />

                    <ImageView
                        android:id="@+id/loanDBProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/ic_loan_db_progress"
                        app:layout_constraintStart_toStartOf="@id/textView180"
                        app:layout_constraintTop_toBottomOf="@id/textView180"/>


                    <TextView
                        android:id="@+id/textView190"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="Available Loan: ₦ 50,000.00"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@+id/loanDBProgress"
                        app:layout_constraintTop_toBottomOf="@+id/loanDBProgress"
                        app:layout_constraintBottom_toBottomOf="parent"/>



                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/ServiceTransfer"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:background="@drawable/loan_dashboard_border_shape"
                android:layout_marginTop="24dp"
                android:padding="15dp"
                android:layout_marginStart="20dp"
                android:drawableTop="@drawable/ic_paper"
                android:drawablePadding="8dp"
                android:fontFamily="@font/opensans_regular"
                android:gravity="center"
                android:text="Loan Record"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/ServiceWithdrawal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardView" />

            <TextView
                android:id="@+id/ServiceWithdrawal"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:padding="15dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/loan_dashboard_border_shape"
                android:drawableTop="@drawable/ic_wallet"
                android:drawablePadding="8dp"
                android:fontFamily="@font/opensans_regular"
                android:gravity="center"
                android:text="Loan Repayment"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/ServiceTransfer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ServiceTransfer" />

            <TextView
                android:id="@+id/recommendLoanText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommended Loan"
                android:layout_marginTop="20dp"
                android:textSize="14sp"
                android:textColor="#191919"
                android:fontFamily="@font/opensans_semibold"
                app:layout_constraintTop_toBottomOf="@id/ServiceTransfer"
                app:layout_constraintStart_toStartOf="@id/guideline20"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all"
                android:textSize="12sp"
                android:textColor="#828282"
                android:fontFamily="@font/opensans_semibold"
                app:layout_constraintTop_toTopOf="@id/recommendLoanText"
                app:layout_constraintBottom_toBottomOf="@id/recommendLoanText"
                app:layout_constraintEnd_toStartOf="@id/guideline19"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline19"
                app:layout_constraintStart_toStartOf="@+id/guideline20"
                app:layout_constraintTop_toBottomOf="@+id/recommendLoanText">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F0F0F0">



                    <TextView
                        android:id="@+id/textView181"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:clickable="false"
                        android:fontFamily="@font/opensans_semibold"
                        android:text="SLS Microfinance Bank"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView191"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="0.3% Interest | 30 days"
                        android:textColor="#828282"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/textView181"
                        app:layout_constraintTop_toBottomOf="@+id/textView181"
                        app:layout_constraintBottom_toTopOf="@id/textView1801"/>

                    <TextView
                        android:id="@+id/textView1801"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clickable="false"
                        android:fontFamily="@font/open_sans_bold"
                        android:text="NGN 500,000"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="@+id/textView191"
                        app:layout_constraintTop_toBottomOf="@+id/textView191" />

                    <ImageView
                        android:id="@+id/loanDBProgress1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/sbbimgpng"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/textView181"/>


                    <TextView
                        android:id="@+id/textView1901"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="Maximum Amount"
                        android:textColor="#828282"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/textView1801"
                        app:layout_constraintTop_toBottomOf="@+id/textView1801"
                        app:layout_constraintBottom_toBottomOf="parent"/>


                    <TextView
                        android:id="@+id/btn_printReceipt"
                        android:layout_width="95dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="20dp"
                        android:gravity="center"
                        android:background="@drawable/loan_apply_btn_shape"
                        android:fontFamily="@font/opensans_semibold"
                        android:text="Apply"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"
                        app:layout_constraintTop_toTopOf="@id/textView1801"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:rippleColor="@color/ripple_white" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView11"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline19"
                app:layout_constraintStart_toStartOf="@+id/guideline20"
                app:layout_constraintTop_toBottomOf="@+id/cardView1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F0F0F0">



                    <TextView
                        android:id="@+id/textView1811"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:clickable="false"
                        android:fontFamily="@font/opensans_semibold"
                        android:text="SLS Microfinance Bank"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView1911"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="0.3% Interest | 30 days"
                        android:textColor="#828282"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/textView1811"
                        app:layout_constraintTop_toBottomOf="@+id/textView1811"
                        app:layout_constraintBottom_toTopOf="@id/textView18011"/>

                    <TextView
                        android:id="@+id/textView18011"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clickable="false"
                        android:fontFamily="@font/open_sans_bold"
                        android:text="NGN 500,000"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="@+id/textView1911"
                        app:layout_constraintTop_toBottomOf="@+id/textView1911" />

                    <ImageView
                        android:id="@+id/loanDBProgress11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/sbbimgpng"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/textView1811"/>


                    <TextView
                        android:id="@+id/textView19011"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="Maximum Amount"
                        android:textColor="#828282"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/textView18011"
                        app:layout_constraintTop_toBottomOf="@+id/textView18011"
                        app:layout_constraintBottom_toBottomOf="parent"/>


                    <TextView
                        android:id="@+id/btn_printReceipt1"
                        android:layout_width="95dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="20dp"
                        android:gravity="center"
                        android:background="@drawable/loan_apply_btn_shape"
                        android:fontFamily="@font/opensans_semibold"
                        android:text="Apply"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"
                        app:layout_constraintTop_toTopOf="@id/textView18011"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:rippleColor="@color/ripple_white" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView112"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline19"
                app:layout_constraintStart_toStartOf="@+id/guideline20"
                app:layout_constraintTop_toBottomOf="@+id/cardView11">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F0F0F0">



                    <TextView
                        android:id="@+id/textView18112"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:clickable="false"
                        android:fontFamily="@font/opensans_semibold"
                        android:text="SLS Microfinance Bank"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView19112"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="0.3% Interest | 30 days"
                        android:textColor="#828282"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/textView18112"
                        app:layout_constraintTop_toBottomOf="@+id/textView18112"
                        app:layout_constraintBottom_toTopOf="@id/textView180112"/>

                    <TextView
                        android:id="@+id/textView180112"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clickable="false"
                        android:fontFamily="@font/open_sans_bold"
                        android:text="NGN 500,000"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="@+id/textView19112"
                        app:layout_constraintTop_toBottomOf="@+id/textView19112" />

                    <ImageView
                        android:id="@+id/loanDBProgress112"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/sbbimgpng"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/textView18112"/>


                    <TextView
                        android:id="@+id/textView190112"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="Maximum Amount"
                        android:textColor="#828282"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/textView180112"
                        app:layout_constraintTop_toBottomOf="@+id/textView180112"
                        app:layout_constraintBottom_toBottomOf="parent"/>


                    <TextView
                        android:id="@+id/btn_printReceipt12"
                        android:layout_width="95dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="20dp"
                        android:gravity="center"
                        android:background="@drawable/loan_apply_btn_shape"
                        android:fontFamily="@font/opensans_semibold"
                        android:text="Apply"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"
                        app:layout_constraintTop_toTopOf="@id/textView180112"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:rippleColor="@color/ripple_white" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>